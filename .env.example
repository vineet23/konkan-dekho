# Admin CMS
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Firebase client (browser) — used for config / bucket name
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=konkandekho-158ab.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — content JSON + media uploads via /api/admin/upload.
# Without this, local content/ JSON is used (good for next dev without Firebase).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional: only if you still run a Netlify mirror; Publish on Vercel does not need this.
# NETLIFY_BUILD_HOOK_URL=
