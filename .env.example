# Admin CMS
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Firebase client (browser) — admin media uploads
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=konkandekho-158ab.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — content JSON in Storage (plots/experiences).
# Without this, local content/ files are used (good for next dev).
# Create a service account in Firebase Console → Project settings → Service accounts.
# Paste the JSON as a single line, or base64-encode it:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Netlify: Publish button triggers a production rebuild
# Site settings → Build & deploy → Build hooks → Add build hook
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxx
