# Admin CMS
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional: Vercel Blob token (production). Without this, local content/ JSON is used.
# Create a Blob store in the Vercel project and paste the read-write token.
# BLOB_READ_WRITE_TOKEN=

# Optional: Firebase client config for admin media uploads
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=konkandekho-158ab.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
